{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/components/HomePage.tsx",
    "src/components/CurtainLoader.tsx",
    "src/components/Hero.tsx",
    "src/components/Navigation.tsx",
    "src/components/PremiumCard.tsx",
    "src/components/MenuSection.tsx",
    "src/components/Footer.tsx",
    "src/components/PortraitOverlay.tsx",
    "src/components/ShineText.tsx",
    "src/components/HorizontalRail.tsx",
    "src/components/ServiceWorkerRegister.tsx",
    "src/lib/**/*.ts",
    "src/data/menu.ts",
    "src/data/brand.ts",
    "src/hooks/useLenis.ts",
    "src/hooks/useNavigation.ts",
    "src/hooks/useOrientationLock.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "vite.config.ts",
    "src/App.tsx",
    "src/main.tsx",
    "src/vite-env.d.ts",
    "src/components/MenuCarousel.tsx",
    "src/components/CategoryNav.tsx",
    "src/components/HeroAmbience.tsx",
    "src/components/CategoryAmbience.tsx",
    "src/components/ScrollRails.tsx",
    "src/components/MenuScrollHint.tsx",
    "src/components/AppLoader.tsx",
    "src/components/GridLines.tsx",
    "src/components/Decorations.tsx",
    "src/components/RiyalSymbol.tsx",
    "src/hooks/useScrollNavigation.ts",
    "src/hooks/useIdleReset.ts",
    "src/hooks/useAppBoot.ts",
    "src/data/dishes.ts"
  ]
}
